# Models (GGUF weights are tracked via checksums.sha256, too large for Git)
models/*.gguf

# Output files generated by users
output/
!output/.gitkeep

# Local logs and temporary files
logs/
!logs/.gitkeep
*.log
*.tmp
_write_test.tmp

# Python cache
__pycache__/
*.py[cod]

# OS generated files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/
